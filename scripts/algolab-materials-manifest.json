    "lab": { "label": "Lab practice", "soonTitle": "Lab exercises coming soon.", "soonBody": "The lab sheet and exercises are being finalized and will be available to download very soon." },
    "problems": { "label": "Problem set", "soonTitle": "Problem set coming soon.", "soonBody": "This problem set is being finalized and will be available to read and download very soon." }
  },

  "comingSoon": {
